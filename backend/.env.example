IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=

# =============================================================================
# Billing — Stripe (hosted Checkout Sessions, subscription mode)
#
# Sandbox and production run the SAME code. The only difference is the VALUES
# below: test-mode values make this a sandbox, live-mode values make it real.
# Leave them empty and the app still boots — checkout just answers HTTP 503.
# See .claude/docs/integrations/BILLING_PROVIDER.md
# =============================================================================

# Secret API key.  sandbox: sk_test_...   production: sk_live_...
# Dashboard > Developers > API keys (a restricted key, rk_..., also works and is
# preferred: it only needs write access to Checkout Sessions).
STRIPE_API_KEY=

# Signing secret of the webhook endpoint (both modes look like whsec_...), used to
# verify every callback. Create an endpoint pointing at
#   POST https://<api host>/api/webhooks/stripe
# subscribed to "checkout.session.completed", then copy its signing secret.
# For local development, `stripe listen --forward-to localhost:8080/api/webhooks/stripe`
# prints a whsec_... to use here.
# Without this, callbacks are refused and no subscription ever activates.
STRIPE_WEBHOOK_SECRET=

# There is NO price id variable. Plans are created in the Stripe dashboard (a Product
# with a recurring monthly BRL Price) and mirrored into the plans table by
# StripeCatalogSync, which runs at startup. Give each Price a lookup_key — it becomes
# the plan's slug in JetMenu. A plan with no Price is reported at startup and its
# checkout answers 503, never a silent success.

# Base URL used to build the Stripe checkout success/cancel return URLs
# (dev default: http://localhost:5173)
APP_FRONTEND_BASE_URL=
